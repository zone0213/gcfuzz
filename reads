    # 阻塞式cmd执行
    @staticmethod
    def exe_cmd(cmd, timeout=120000):
        ret = 'error'
        try:
            # 执行成功
            ret = subprocess.check_output(cmd, timeout=timeout, stderr=subprocess.STDOUT)
            return ret.decode('gbk', 'ignore').encode('utf-8')
        except subprocess.CalledProcessError as e:
            print('cmd->%s  execute error output= %s' % (cmd, e.output))
        except subprocess.TimeoutExpired as e1:
            print('cmd->%s  execute error output= %s' % (cmd, e1.output))
        return ret

    @staticmethod
    def insert_lines_after_x(filename, x, new_lines):
        """
        在文件的第 x 行和 x+1 行之间插入多行数据，
        插入行的缩进与 x+1 行一致。
        :param filename:文件路径
        :param x: 插入位置（第 x 行之后，注意：x 从 0 开始计数）
        :param new_lines: 要插入的新行列表，如 ['line1', 'line2']
        """
        # 读取原文件内容
        with open(filename, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        # 检查 x 是否有效
        if x < 0 or x >= len(lines):
            raise ValueError(f"行号 x 必须在 0 到 {len(lines) - 1} 之间")
        # 获取 x+1 行的原始内容（用于提取缩进）
        next_line = lines[x - 1]
        # 提取前导空白字符（空格和制表符）
        indent = ''
        for char in next_line:
            if char in ' 	':
                indent += char
            else:
                break
        # 构造插入内容（每行前面加上相同的缩进）
        inserted_lines = []
        for line in new_lines:
            inserted_lines.append(indent + line)
        # 插入到第 x 行之后（即在 x+1 位置前插入）
        lines[x + 1:x + 1] = inserted_lines
        # 写回文件
        with open(filename, 'w', encoding='utf-8') as f:
            f.writelines(lines)

