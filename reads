class CommonUtils(object):
    def __init__(self):
        self.testRounds = 0

    # 非阻塞cmd执行
    @staticmethod
    def exe(cmd):
        pi = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE)
        return pi.stdout

    # 阻塞式cmd执行
    @staticmethod
    def exe_cmd(cmd, timeout=120000):
        ret = b'error'
        try:
            # 执行成功
            ret = subprocess.check_output(cmd, timeout=timeout, stderr=subprocess.STDOUT)
            return ret.decode('gbk', 'ignore').encode('utf-8')
        except subprocess.CalledProcessError as e:
            print('cmd->%s  execute error output= %s' % (cmd, e.output))
        except subprocess.TimeoutExpired as e1:
            print('cmd->%s  execute error output= %s' % (cmd, e1.output))
        return ret

    @staticmethod
    def insert_lines_after_x(filename, x, new_lines):
        with open(filename, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        if x < 0 or x >= len(lines):
            raise ValueError(f"行号 x 必须在 0 到 {len(lines) - 1} 之间")
        next_line = lines[x - 1]
        indent = ''
        for char in next_line:
            if char in ' \t':
                indent += char
            else:
                break
        inserted_lines = []
        for line in new_lines:
            inserted_lines.append(indent + line + '\n')
        lines[x + 1:x + 1] = inserted_lines
        with open(filename, 'w', encoding='utf-8') as f:
            f.writelines(lines)

    @staticmethod
    def copy_and_rename_file(source_file, new_filename):
        source_dir = os.path.dirname(source_file)
        destination_file = os.path.join(source_dir, new_filename)
        shutil.copy2(str(source_file), str(destination_file))

    @staticmethod
    def hdc_shell_cmd(sn, cmd):
        cmd = f'hdc -t {sn} shell "{cmd}"'
        print(f"cmd: {cmd}")
        return CommonUtils.exe_cmd(cmd)

    @staticmethod
    def hdc_file_send(sn, src, des):
        cmd = f'hdc -t {sn} file send "{src}" "{des}"'
        print(f"cmd: {cmd}")
        return CommonUtils.exe_cmd(cmd)

    @staticmethod
    def hdc_file_recv(sn, src, des):
        cmd = f'hdc -t {sn} file recv "{src}" "{des}"'
        print(f"cmd: {cmd}")
        return CommonUtils.exe_cmd(cmd)

    @staticmethod
    def updateFile(file, old_str, new_str):
        file_data = ''
        with open(file, 'r', encoding="utf-8") as f:
            for line in f:
                if old_str in line:
                    line = line.replace(old_str, new_str)
                file_data = file_data + line
        with open(file, "w", encoding="utf-8") as f:
            f.write(file_data)

    @staticmethod
    def start_collect_trace(sn, method, cpu_time=600):
        cmd = 'hdc -t {0} shell "hiprofiler_cmd -o /data/local/tmp/hiprofiler_{1}.htrace -t {2} -s -k --config /data/local/tmp/trace_hiperf_config.txt"'.format(
            sn, method, cpu_time
        )
        print(cmd)
        CommonUtils.exe(cmd)
        time.sleep(3)

    @staticmethod
    def stop_collect_trace(sn, method, report_path):
        cmd = 'hdc -t {} shell "ls -l /data/local/tmp" '.format(sn)
        result = CommonUtils.exe_cmd(cmd).decode().split('\r\n')
        trace_name_list = list()
        for line in result:
            line_info = line.split()
            if len(line_info) > 7:
                file_name = line_info[-1]
                if 'hiprofiler_' in file_name and '.htrace' in file_name and method in file_name:
                    trace_name_list.append(file_name)
        cmd1 = 'hdc -t {0} shell "pidof hiprofiler_cmd | xargs kill -SIGINT"'.format(sn)
        CommonUtils.exe(cmd1)
        time.sleep(20)
        cmd2 = 'hdc -t {0} shell "ps -ef > /data/local/tmp/ps_ef.txt"'.format(sn)
        CommonUtils.exe(cmd2)
        time.sleep(2)
        hitrace_path = os.path.join(report_path, 'hitrace')
        CommonUtils.create_directory(hitrace_path)
        cmd3 = 'hdc -t {0} file recv /data/local/tmp/ps_ef.txt {1}'.format(sn, report_path)
        CommonUtils.exe_cmd(cmd3)
        for file_name in trace_name_list:
            cmd4 = 'hdc -t {0} file recv /data/local/tmp/{1} {2}'.format(sn, file_name, hitrace_path)
            CommonUtils.exe_cmd(cmd4)
            cmd5 = 'hdc -t {0} shell "rm -rf /data/local/tmp/{1}"'.format(sn, file_name)
            CommonUtils.exe_cmd(cmd5)

    @staticmethod
    def getThreadAndPid_prune(sn):
        normal_dir = dict()
        hidumperFile = CommonUtils.exe_cmd('hdc -t {} shell hidumper --mem --prune'.format(sn)).decode()
        lines = hidumperFile.split('\n')
        for line in lines[3:]:
            line_info = line.split()
            if len(line_info) > 8:
                pid = line_info[0]
                process_name = line_info[-1]
                normal_dir[pid] = process_name
        return normal_dir

    @staticmethod
    def get_timestamp() -> str:
        milliseconds = datetime.datetime.now().microsecond // 1000
        return datetime.datetime.now().strftime("%Y%m%d%H%M%S" + "{:03d}".format(milliseconds))

    @staticmethod
    def getTime():
        return time.strftime('%Y%m%d-%H%M%S', time.localtime(time.time()))

    @staticmethod
    def reboot(d: UiExplorer):
        d.System.reboot()
        d.System.wait_for_boot_complete()
        d.wake_up_display()
        d.swipe_to_back()
        d.swipe_to_recent_task()
        if d.find_component(BY.key("com.huawei.android.launcher:id/clear_all_recents_image_button")):
            d.touch(BY.key("com.huawei.android.launcher:id/clear_all_recents_image_button"))
        d.go_home()

    @staticmethod
    def get_battera_capacity(sn):
        temp = CommonUtils.exe_cmd('adb -s {} shell "cat /sys/class/power_supply/Battery/capacity"'.format(sn))
        try:
            return int(temp.decode().strip())
        except:
            return 0

    @staticmethod
    def run_with_timeout(func, timeout):
        with concurrent.futures.ThreadPoolExecutor() as executor:
            future = executor.submit(func)
            try:
                result = future.result(timeout=timeout)
                return result
            except concurrent.futures.TimeoutError:
                print("Execution Timeout")
                future.cancel()
                return None

    @staticmethod
    def create_directory(path):
        Path(path).mkdir(parents=True, exist_ok=True)
        return path

    @staticmethod
    def touch_OH(sn, x1, y1):
        CommonUtils.exe_cmd('hdc -t {0} shell uinput -T -c {1} {2} 50'.format(sn, str(x1), str(y1)))

    @staticmethod
    def swipe_OH(sn, x1, y1, x2, y2, time=300):
        CommonUtils.exe_cmd(
            'hdc -t {0} shell uinput -T -m {1} {2} {3} {4} {5}'.format(sn, str(x1), str(y1), str(x2), str(y2), str(time))
        )

    @staticmethod
    def get_sn(index=0):
        # 简化版获取SN逻辑
        try:
            result = subprocess.check_output("hdc list targets", shell=True).decode()
            sns = [line.strip() for line in result.split('\n') if line.strip()]
            return sns[index] if index < len(sns) else ""
        except:
            return ""

    @staticmethod
    def get_user_name():
        return os.getlogin()


def translate_json(file_path):
    data_dict = {}
    if not os.path.exists(file_path):
        return
    with open(file_path, "r", encoding='utf-8') as file:
        lines = file.readlines()
        for line in lines:
            if ':' in line:
                parts = line.strip().split(':', 1)
                key = parts[0].strip()
                value = parts[1].strip()
                if key == "casename":
                    value = value.replace('b', '').replace("'", "")
                data_dict[key] = value

    json_str = json.dumps(data_dict, indent=4, ensure_ascii=False)
    json_file_path = file_path.replace('.txt', '.json')
    with open(json_file_path, 'w', encoding='utf-8') as json_file:
        json_file.write(json_str)


