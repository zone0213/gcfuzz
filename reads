    @staticmethod
    def memdumper_get_startAddr(d: UiExplorer, packagename, activityName):
        def rematch(info):
            matches = re.findall(r"'(.*?)'", str(info))
            matches2 = re.findall(r'"(.*?)"', str(info))
            if matches:
                return matches[0]
            if matches2:
                return matches2[0]

        def split_hap(info):  # 处理map命令查询到的hap，将字符串存储成列表
            matches = re.split(r'(?<=\.hap)', info)
            return matches

        def split_hsp(info):  # 处理map命令查询到的hsp，将字符串存储成列表
            matches = re.split(r'(?<=\.hsp)', info)
            return matches

        def deal_with_haps(haps):  # 根据地址找到不同的hap/hsp
            result = []
            prev_line = None
            count = 0
            index = 0
            for line in haps:
                parts = line.split()
                num1 = parts[0].split('-')[0]  # 当前行的第一个地址
                file_name = parts[-1].split('/')[-1]  # hap名称
                if count == 0:
                    file_name = str(index) + '_' + file_name
                    result.append((num1, file_name))
                    prev_line = line
                    count += 1
                    continue
                if prev_line:
                    prev_parts = prev_line.split()
                    prev_num2 = prev_parts[0].split('-')[1]  # 上一行的第二个地址
                    prev_file2 = prev_parts[-1].split('/')[-1]  # 上一行的hap名
                    if prev_num2 != num1 or file_name != prev_file2:
                        if prev_num2 != num1 and file_name == prev_file2:
                            file_name = str(index + 1) + '_' + file_name
                            result.append((num1, file_name))
                        else:
                            index = 0
                            file_name = str(index) + '_' + file_name
                            result.append((num1, file_name))
                prev_line = line
                count += 1
            return result

        def hap_to_abc(result, pid, packagename):  # 使用memdumper转换abc
            count = 0
            for item in result:
                filename = str(item[1]) + ".abc"
                CommonUtils.exe_cmd(
                    f'hdc -t {d.sn} shell /data/local/tmp/memdumper -s {item[0]} -n {filename} -o /data/local/decrypt/ -f -i {pid} -k'
                )
                count = count + 1
            return count

        if not activityName:
            return
        # 启动应用
        d.start_app(packagename, activityName)
        # 删除ps_ef
        CommonUtils.exe_cmd('hdc -t {0} shell rm -rf /data/local/tmp/ps_ef.txt'.format(d.sn))
        # 删除memdumper文件夹
        CommonUtils.exe_cmd('hdc -t {0} shell rm -rf /data/local/decrypt'.format(d.sn))
        # 创建memdumper文件夹
        CommonUtils.exe_cmd('hdc -t {0} shell mkdir /data/local/decrypt'.format(d.sn))
        # 查询应用pid
        pid = (
            str(CommonUtils.exe_cmd('hdc -t {0} shell "pidof {1}"'.format(d.sn, packagename)))
            .replace("\\r", "")
            .replace("\\n", "")
        )
        pid_f = rematch(pid)
        print(f"=============pid==============={pid_f}")
        if pid_f:
            # 找到应用的hap文件名称和hap在内存中的起始位置startAddr
            startAddr_all = (
                str(
                    CommonUtils.exe_cmd(
                        'hdc -t {0} shell "cat /proc/{1}/maps | grep /data/storage/el1/bundle/ | grep hap"'.format(
                            d.sn, pid_f
                        )
                    )
                )
                .replace("\\r", "")
                .replace("\\n", "")
            )
            startAddr_all_f = rematch(startAddr_all)
            CommonUtils.exe_cmd(
                'hdc -t {0} shell "cat /proc/{1}/maps | grep /data/storage/el1/bundle/ | grep hap >> /data/local/decrypt/map.txt"'.format(
                    d.sn, pid_f
                )
            )

            startAddr_all_hsp = (
                str(
                    CommonUtils.exe_cmd(
                        'hdc -t {0} shell "cat /proc/{1}/maps | grep /data/storage/el1/bundle/ | grep hsp"'.format(
                            d.sn, pid_f
                        )
                    )
                )
                .replace("\\r", "")
                .replace("\\n", "")
            )
            startAddr_all_hsp_f = rematch(startAddr_all_hsp)
            CommonUtils.exe_cmd(
                'hdc -t {0} shell "cat /proc/{1}/maps | grep /data/storage/el1/bundle/ | grep hsp >> /data/local/decrypt/map.txt"'.format(
                    d.sn, pid_f
                )
            )

            if startAddr_all_f or startAddr_all_hsp_f:
                # 所有地址的hap包
                haps = split_hap(startAddr_all_f)
                if startAddr_all_hsp_f:
                    hsp = split_hsp(startAddr_all_hsp_f)
                    addrs = haps + hsp
                    filtered_lst = list(filter(None, addrs))
                    print(filtered_lst)
                    result = deal_with_haps(filtered_lst)
                else:
                    filtered_lst = list(filter(None, haps))
                    result = deal_with_haps(filtered_lst)
                hap_to_abc(result, pid_f, packagename)
        d.stop_app(packagename)

