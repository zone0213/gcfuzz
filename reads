        resultlist = []
        for i in dirlist:
            if i.endswith('.txt'):
                with open(os.path.join(resultPath, i)) as f:
                    lines = f.readlines()
                    lines2 = []
                    if len(lines) > 1:
                        for j in lines:
                            lines2.append([j.split()[0], j.split()[1]])
                        namelist = i.split('_')
                        if namelist[0] + "_" + namelist[1] not in dirdict.keys():
                            dirdict[namelist[0] + "_" + namelist[1]] = [lines2]
                        else:
                            dirdict[namelist[0] + "_" + namelist[1]].append(lines2)
        for key in dirdict.keys():
            resultlist.append([key])
            for i in range(0, len(dirdict[key][0])):
                resultlist.append([dirdict[key][0][i][0], int(dirdict[key][1][i][1]) - int(dirdict[key][0][i][1])])
        excel_path = os.path.join(resultPath, 'parse_cputime_{}.xlsx'.format(time.time()))
